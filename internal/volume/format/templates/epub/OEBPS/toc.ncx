<?xml version="1.0" encoding="UTF-8"?>
<ncx version="2005-1" xml:lang="en-US" xmlns="http://www.daisy.org/z3986/2005/ncx/">
    <head>
        <meta name="dtb:uid" content="{{ .VolumeID }}"/>
        <meta name="dtb:depth" content="{{ .TableOfContentsDepth }}"/>
        <meta name="dtb:totalPageCount" content="{{ .TotalPageCount }}"/>
        <meta name="dtb:maxPageNumber" content="{{ .TotalPageCount }}"/>
        <meta name="generated" content="true"/>
    </head>
    <docTitle><text>{{ .Title }}</text></docTitle>
    <navMap>
        {{- template "navPoints" .TableOfContents }}
    </navMap>
</ncx>
{{- define "navPoints" }}
        {{- range . }}
        <navPoint id="{{ .Id }}" playOrder="{{ .PlayOrder }}">
            <navLabel>
                <text>{{ .Label }}</text>
            </navLabel>
            <content src="{{ .Url }}"/>
            {{- if .Children }}{{ template "navPoints" .Children }}{{ end }}
        </navPoint>
        {{- end }}
{{- end }}
